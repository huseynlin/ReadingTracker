@model ReadingTracker.Models.User
@{
    ViewData["Title"] = "Qeydiyyat";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg" style="border-radius: 25px;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-plus-fill fs-3"></i>
                        </div>
                        <h2 class="fw-bold">Yeni Hesab</h2>
                        <p class="text-muted">Məlumatları daxil edərək qeydiyyatdan keçin</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-600">İstifadəçi Adı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-at"></i></span>
                                <input asp-for="Username" class="form-control bg-light border-0 py-2" placeholder="Məs: kitabsevər" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-600">Şifrə</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control bg-light border-0 py-2" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm" style="border-radius: 12px;">
                            Hesab Yarat
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <span class="text-muted">Artıq hesabınız var?</span>
                        <a href="/Account/Login" class="text-primary fw-bold text-decoration-none ms-1">Daxil olun</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Giriş";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="auth-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="text-center mb-4 animate-up">
                    <div class="auth-logo mb-2">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <h2 class="auth-title">Xoş Gəlmisiniz</h2>
                    <p class="auth-subtitle">Kitab dünyanıza daxil olun</p>
                </div>

                <div class="auth-card shadow-lg animate-up delay-1">
                    <div class="card-body p-4 p-md-5">
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-modern-danger animate-shake">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                @Html.ValidationSummary(true, "")
                            </div>
                        }

                        <form asp-action="Login" method="post" class="auth-form">
                            <div class="mb-3">
                                <label for="username" class="form-label">İstifadəçi Adı</label>
                                <div class="input-group-modern">
                                    <i class="bi bi-person"></i>
                                    <input type="text" id="username" name="username" class="form-control" placeholder="İstifadəçi adınız" required />
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <label for="password" class="form-label">Şifrə</label>
                                <div class="input-group-modern">
                                    <i class="bi bi-lock"></i>
                                    <input type="password" id="password" name="password" class="form-control" placeholder="Şifrəniz" required />
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-auth-primary w-100 py-3 mb-3">
                                Giriş Et <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </form>
                        
                        <div class="text-center mt-2">
                            <span class="text-muted small">Hesabınız yoxdur?</span>
                            <a href="/Account/Register" class="auth-link ms-1">Qeydiyyatdan keçin</a>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4 animate-up delay-2">
                    <a href="/" class="btn btn-link btn-sm text-decoration-none text-muted">
                        <i class="bi bi-house-door me-1"></i> Ana səhifəyə qayıt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --auth-primary: #4361ee;
        --auth-bg: #f8fafc;
        --auth-text: #1e293b;
    }

    body {
        background-color: var(--auth-bg);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .auth-logo {
        font-size: 3rem;
        color: var(--auth-primary);
        display: inline-block;
    }

    .auth-title {
        font-weight: 800;
        color: var(--auth-text);
        letter-spacing: -0.5px;
        margin-bottom: 5px;
    }

    .auth-subtitle {
        color: #64748b;
        font-size: 0.95rem;
    }

    /* Modern Card */
    .auth-card {
        background: white;
        border: none;
        border-radius: 28px;
        border: 1px solid rgba(0,0,0,0.03);
    }

    /* Input Group Modern */
    .input-group-modern {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-group-modern i {
        position: absolute;
        left: 15px;
        color: #94a3b8;
        font-size: 1.1rem;
    }

    .input-group-modern .form-control {
        padding: 12px 15px 12px 45px;
        border-radius: 14px;
        background-color: #f1f5f9;
        border: 2px solid transparent;
        transition: all 0.3s;
        font-weight: 500;
    }

    .input-group-modern .form-control:focus {
        background-color: white;
        border-color: var(--auth-primary);
        box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #475569;
        margin-left: 5px;
    }

    /* Primary Auth Button */
    .btn-auth-primary {
        background: var(--auth-primary);
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 700;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(67, 97, 238, 0.2);
    }

    .btn-auth-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(67, 97, 238, 0.3);
        color: white;
    }

    .auth-link {
        color: var(--auth-primary);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .auth-link:hover {
        text-decoration: underline;
    }

    /* Danger Alert */
    .alert-modern-danger {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
        color: #b91c1c;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    /* Animations */
    .animate-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
    }

    .animate-shake {
        animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
    }

    .delay-1 { animation-delay: 0.15s; }
    .delay-2 { animation-delay: 0.3s; }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes shake {
        10%, 90% { transform: translate3d(-1px, 0, 0); }
        20%, 80% { transform: translate3d(2px, 0, 0); }
        30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
        40%, 60% { transform: translate3d(4px, 0, 0); }
    }
</style>
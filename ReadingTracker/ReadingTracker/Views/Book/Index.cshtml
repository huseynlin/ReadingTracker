@model IEnumerable<ReadingTracker.Models.Book>
@{
    ViewData["Title"] = "Kitablarım";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="main-wrapper py-5">
    <div class="container">
        <div class="row align-items-center mb-5 gy-4">
            <div class="col-md-8">
                <h1 class="header-title">Kitab Səyahətim</h1>
                <p class="text-muted">Oxuduğunuz hər kitab yeni bir dünyadır.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="Create" class="btn btn-modern-primary shadow-sm">
                    <i class="bi bi-plus-circle-fill me-2"></i>Yeni Kitab
                </a>
            </div>
        </div>

        <div class="filter-panel mb-5 shadow-sm p-2 d-inline-flex gap-2 bg-white">
            <a href="/books/my-list" class="filter-btn @(ViewBag.CurrentFilter == null ? "active" : "")">
                Hamısı
            </a>
            <a href="/books/my-list?statusFilter=0" class="filter-btn @(ViewBag.CurrentFilter?.ToString() == "Oxunur" ? "active" : "")">
                <i class="bi bi-book-half me-2"></i>Oxunur
            </a>
            <a href="/books/my-list?statusFilter=1" class="filter-btn @(ViewBag.CurrentFilter?.ToString() == "Bitirilib" ? "active" : "")">
                <i class="bi bi-check-circle-fill me-2"></i>Bitirilib
            </a>
        </div>

        <div class="row g-4">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-journal-x display-1 text-muted opacity-25"></i>
                    <h4 class="mt-4 text-secondary">Hələ ki kitab əlavə etməmisiniz.</h4>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="book-card shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="status-badge @(item.Status == ReadingTracker.Models.BookStatus.Bitirilib ? "status-done" : "status-reading")">
                                        <i class="bi @(item.Status == ReadingTracker.Models.BookStatus.Bitirilib ? "bi-check-circle-fill" : "bi-book-half") me-1"></i>
                                        @item.Status
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                            <li><a class="dropdown-item" href="/books/details/@item.Id">Bax</a></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?')">
                                                    <button type="submit" class="dropdown-item text-danger">Sil</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <h5 class="book-title">@item.Title</h5>
                                <p class="book-author">@item.Author</p>
                                <p class="book-summary">
                                    @item.Summary
                                </p>
                            </div>
                            <div class="card-footer-modern px-4 pb-4">
                                <div class="d-flex gap-2">
                                    <a href="/books/details/@item.Id" class="btn btn-outline-secondary btn-custom flex-grow-1">
                                        Detallar
                                    </a>
                                    @if (item.Status == ReadingTracker.Models.BookStatus.Oxunur)
                                    {
                                        <form action="/books/mark-finished/@item.Id" method="post" class="flex-grow-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-modern-success w-100 btn-custom">
                                                Bitir <i class="bi bi-check-lg ms-1"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    /* Ümumi Tənzimləmələr */
    :root {
        --primary-modern: #4361ee; /* Giriş ekranındakı göy rəng */
        --success-modern: #2ec4b6;
        --bg-modern: #f8fafc; /* Giriş ekranının fon rəngi */
        --card-border-radius: 18px; /* Kart küncləri */
        --text-main: #1e293b;
    }

    body {
        background-color: var(--bg-modern);
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-main);
    }

    /* Başlıq */
    .header-title {
        font-weight: 800;
        letter-spacing: -1px;
        color: var(--text-main);
    }

    /* Modern Düymə */
    .btn-modern-primary {
        background: var(--primary-modern);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-modern-primary:hover {
            background: #2a40ca;
            color: white;
        }

    /* Filtr Paneli */
    .filter-panel {
        border-radius: 15px;
        background: white;
    }

    .filter-btn {
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 10px;
        color: #64748b;
        font-weight: 600;
        transition: 0.2s;
    }

        .filter-btn.active {
            background-color: var(--bg-modern);
            color: var(--primary-modern);
        }

    /* Kitab Kartı (Giriş ekranına uyğun dizayn) */
    .book-card {
        background: white;
        border: none;
        border-radius: var(--card-border-radius);
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.03);
    }

        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
        }

    .book-title {
        font-weight: 700;
        color: var(--text-main);
        font-size: 1.2rem;
        margin-bottom: 3px;
    }

    .book-author {
        color: var(--primary-modern);
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 12px;
    }

    .book-summary {
        font-size: 0.9rem;
        color: #64748b;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Status Badge */
    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
    }

    .status-reading {
        background: #fff4e6;
        color: #ff922b;
    }

    .status-done {
        background: #e6fcf5;
        color: #20c997;
    }

    /* Footer Düymələri */
    .btn-custom {
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 12px;
    }

    .btn-modern-success {
        background: var(--success-modern);
        color: white;
        border: none;
    }

        .btn-modern-success:hover {
            background: #25a196;
            color: white;
        }
</style>